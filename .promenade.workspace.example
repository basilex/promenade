# Promenade Workspace Configuration
# ==================================
# Copy this file to .promenade.workspace and customize for your setup
# cp .promenade.workspace.example .promenade.workspace

# Database Driver Selection
# -------------------------
# Supported: postgres | mssql
#
# Current status:
# - postgres: Production-ready (PostgreSQL 14+)
# - mssql: Planned for future enterprise deployments
#
# Default: postgres
DATABASE_DRIVER=postgres

# Environment Selection
# ---------------------
# Options: development | test | production
# Default: development
ENVIRONMENT=development

# Optional: Database Connection Overrides
# ----------------------------------------
# Uncomment to override defaults from config/app.{driver}-{env}.yaml

# PostgreSQL (current)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=system
# DB_PASSWORD=passw0rd
# DB_NAME=promenade_dev
# DB_SSLMODE=disable

# MS SQL Server (future)
# DB_HOST=localhost
# DB_PORT=1433
# DB_USER=sa
# DB_PASSWORD=YourPassword123
# DB_NAME=promenade_dev
# DB_INSTANCE=SQLEXPRESS  # Optional: named instance

# Redis
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=

# JWT
# JWT_SECRET=your-secret-key-at-least-32-characters

# Server
# SERVER_PORT=8081
# SERVER_HOST=0.0.0.0

# Logging
# LOG_LEVEL=debug  # debug | info | warn | error

# Notes:
# ------
# 1. .promenade.workspace is git-ignored (local only)
# 2. Use 'make switch-postgres-dev' to switch to PostgreSQL development
# 3. Use 'make switch-mssql-dev' when MS SQL Server support is ready
# 4. All make commands read this file automatically
# 5. Migrations are database-specific: migrations/{driver}/{namespace}/
# 6. PostgreSQL 14+ required - use Docker Compose for local development
