# Promenade Workspace Configuration
# ==================================
# Copy this file to .promenade.workspace and customize for your setup
# cp .promenade.workspace.example .promenade.workspace

# Database Driver Selection
# -------------------------
# Current: postgres (PostgreSQL 14+)
#
# Default: postgres
DATABASE_DRIVER=postgres

# Environment Selection
# ---------------------
# Options: development | test | production
# Default: development
ENVIRONMENT=development

# Optional: Database Connection Overrides
# ----------------------------------------
# Uncomment to override defaults from config/app.postgres-{env}.yaml

# PostgreSQL
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=system
# DB_PASSWORD=passw0rd
# DB_NAME=promenade_dev
# DB_SSLMODE=disable

# Redis
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=

# JWT
# JWT_SECRET=your-secret-key-at-least-32-characters

# Server
# SERVER_PORT=8081
# SERVER_HOST=0.0.0.0

# Logging
# LOG_LEVEL=debug  # debug | info | warn | error

# Notes:
# ------
# 1. .promenade.workspace is git-ignored (local only)
# 2. Use 'make switch-postgres-dev' to switch to PostgreSQL development
# 3. All make commands read this file automatically
# 4. Migrations are in migrations/postgres/{namespace}/
# 5. PostgreSQL 14+ required - use Docker Compose for local development
