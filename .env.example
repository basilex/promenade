# ============================================================================
# Application Configuration
# ============================================================================
# APP_NAME: Application display name used in emails and UI
# APP_URL: Base URL for generating links in emails and callbacks
APP_NAME=Promenade
APP_URL=http://localhost:8081

# ============================================================================
# Server Configuration
# ============================================================================
# SERVER_PORT: HTTP server listening port
# ENVIRONMENT: Runtime environment (development, staging, production)
#   Affects logging verbosity, error details, and fallback behaviors
SERVER_PORT=8081
ENVIRONMENT=development

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL connection settings
# DB_HOST: Database server hostname or IP address
# DB_PORT: PostgreSQL port (default: 5432)
# DB_USER: Database username for authentication
# DB_PASSWORD: Database password (use strong password in production)
# DB_NAME: Database name to connect to
# DB_SSLMODE: SSL mode (disable, require, verify-ca, verify-full)
#   Use 'require' or higher in production
# DB_MAX_OPEN_CONNS: Maximum number of open database connections
# DB_MAX_IDLE_CONNS: Maximum number of idle connections in the pool
DB_HOST=localhost
DB_PORT=5432
DB_USER=system
DB_PASSWORD=password
DB_NAME=promenade_dev
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# ============================================================================
# JWT Configuration
# ============================================================================
# JWT_SECRET: Secret key for signing JWT tokens
#   Generate with: openssl rand -base64 32
#   CRITICAL: Change this in production!
# JWT_ACCESS_TTL_MINUTES: Access token lifetime in minutes (default: 15)
# JWT_REFRESH_TTL_HOURS: Refresh token lifetime in hours (default: 168 = 7 days)
JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168

# ============================================================================
# Swagger Configuration
# ============================================================================
# SWAGGER_ENABLED: Enable/disable Swagger UI (disable in production)
# SWAGGER_HOST: Host address for Swagger documentation
SWAGGER_ENABLED=true
SWAGGER_HOST=localhost:8081

# ============================================================================
# Rate Limiting
# ============================================================================
# RATE_LIMIT_RPS: Requests per second allowed per IP
# RATE_LIMIT_BURST: Maximum burst size for request bursts
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# ============================================================================
# Event Bus Configuration
# ============================================================================
# BUS_ADAPTER: Event bus adapter type
#   - "memory" : In-memory adapter (fast, suitable for dev and single-instance)
#   - "redis"  : Redis Pub/Sub adapter (distributed, for multi-instance and microservices)
# Note: In production, automatically falls back to memory if Redis is unavailable
#
# BUS_WORKER_POOL_SIZE: Number of concurrent workers processing events
# BUS_BUFFER_SIZE: Event queue buffer size
# BUS_RETRY_ATTEMPTS: Maximum retry attempts for failed event handlers
# BUS_RETRY_DELAY: Initial delay before first retry (supports: 1s, 100ms, etc.)
# BUS_RETRY_MAX_DELAY: Maximum delay between retries (caps exponential backoff)
# BUS_RETRY_MULTIPLIER: Exponential backoff multiplier (2.0 = doubles each time)
BUS_ADAPTER=memory
BUS_WORKER_POOL_SIZE=10
BUS_BUFFER_SIZE=1000
BUS_RETRY_ATTEMPTS=3
BUS_RETRY_DELAY=1s
BUS_RETRY_MAX_DELAY=5s
BUS_RETRY_MULTIPLIER=2.0

# ============================================================================
# Redis Configuration (used when BUS_ADAPTER=redis)
# ============================================================================
# REDIS_HOST: Redis server hostname or IP address
# REDIS_PORT: Redis server port (default: 6379)
# REDIS_PASSWORD: Redis authentication password (leave empty if no auth)
# REDIS_DB: Redis database number (0-15, default: 0)
# REDIS_POOL_SIZE: Connection pool size for Redis client
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# ============================================================================
# Email Configuration
# ============================================================================
# EMAIL_FROM_NAME: Sender name displayed in emails
# EMAIL_FROM_ADDRESS: Sender email address
EMAIL_FROM_NAME=Promenade Team
EMAIL_FROM_ADDRESS=noreply@promenade.com

# ============================================================================
# Purge Configuration (Soft Delete Cleanup)
# ============================================================================
# PURGE_ENABLED: Enable/disable automatic purge of soft-deleted records
# PURGE_SCHEDULE: Cron schedule for purge job (format: "second minute hour day month weekday")
#   Default: "0 2 * * *" = 2 AM daily (6 fields required)
# PURGE_DRY_RUN: If true, logs what would be purged without actually deleting
# PURGE_BATCH_SIZE: Number of records to purge in a single batch
# PURGE_RETENTION_USER_POSTS: Days to retain soft-deleted user posts (default: 90)
# PURGE_RETENTION_POST_COMMENTS: Days to retain soft-deleted comments (default: 30)
PURGE_ENABLED=true
PURGE_SCHEDULE=0 2 * * *
PURGE_DRY_RUN=false
PURGE_BATCH_SIZE=1000
PURGE_RETENTION_USER_POSTS=90
PURGE_RETENTION_POST_COMMENTS=30
