# ============================================================================
# Application Configuration
# ============================================================================
# APP_NAME: Application display name used in emails and UI
# APP_URL: Base URL for generating links in emails and callbacks
APP_NAME=Promenade
APP_URL=http://localhost:8081

# ============================================================================
# Server Configuration
# ============================================================================
# SERVER_PORT: HTTP server listening port
# ENVIRONMENT: Runtime environment (development, staging, production)
#   Development mode enables: debug logging, detailed errors, Swagger UI
SERVER_PORT=8081
ENVIRONMENT=development

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL connection settings for development database
# DB_HOST: Database server hostname (localhost for local development)
# DB_PORT: PostgreSQL port (default: 5432)
# DB_USER: Database username
# DB_PASSWORD: Database password (development only - not for production!)
# DB_NAME: Database name (promenade_dev for development)
# DB_SSLMODE: SSL mode (disable for local development)
# DB_MAX_OPEN_CONNS: Maximum number of open connections (lower for dev)
# DB_MAX_IDLE_CONNS: Maximum idle connections in pool
DB_HOST=localhost
DB_PORT=5432
DB_USER=system
DB_PASSWORD=passw0rd
DB_NAME=promenade_dev
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# ============================================================================
# JWT Configuration
# ============================================================================
# JWT_SECRET: Secret key for signing JWT tokens
#   Generated with: openssl rand -base64 32
#   This is a development secret - never use in production!
# JWT_ACCESS_TTL_MINUTES: Short-lived access token (15 minutes)
# JWT_REFRESH_TTL_HOURS: Long-lived refresh token (7 days)
JWT_SECRET=xTV/YnVTg4aoOiNLrLipZZMQfLwZDgDaEMBxzSz6l1s=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168

# ============================================================================
# Swagger Configuration
# ============================================================================
# SWAGGER_ENABLED: Always enabled in development for API testing
# SWAGGER_HOST: Local development host
SWAGGER_ENABLED=true
SWAGGER_HOST=localhost:8081

# ============================================================================
# Rate Limiting
# ============================================================================
# RATE_LIMIT_RPS: Requests per second (relaxed for development)
# RATE_LIMIT_BURST: Burst capacity for traffic spikes
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# ============================================================================
# Event Bus Configuration
# ============================================================================
# BUS_ADAPTER: Event bus adapter type
#   - "memory" : In-memory adapter (fast, suitable for dev and single-instance)
#   - "redis"  : Redis Pub/Sub adapter (distributed, for multi-instance and microservices)
# Development: Use memory for fast development without external dependencies
#
# BUS_WORKER_POOL_SIZE: Concurrent workers (lower for dev to save resources)
# BUS_BUFFER_SIZE: Event queue size (smaller for dev)
# BUS_RETRY_ATTEMPTS: Max retries for failed handlers
# BUS_RETRY_DELAY: Initial retry delay
# BUS_RETRY_MAX_DELAY: Max delay cap (longer for dev testing)
# BUS_RETRY_MULTIPLIER: Exponential backoff multiplier
BUS_ADAPTER=memory
BUS_WORKER_POOL_SIZE=4
BUS_BUFFER_SIZE=100
BUS_RETRY_ATTEMPTS=3
BUS_RETRY_DELAY=1s
BUS_RETRY_MAX_DELAY=30s
BUS_RETRY_MULTIPLIER=2.0

# ============================================================================
# Redis Configuration (used when BUS_ADAPTER=redis)
# ============================================================================
# REDIS_HOST: Local Redis instance (if testing distributed mode)
# REDIS_PORT: Standard Redis port
# REDIS_PASSWORD: No password for local development
# REDIS_DB: Database 0 (default)
# REDIS_POOL_SIZE: Connection pool size
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# ============================================================================
# Email Configuration
# ============================================================================
# EMAIL_FROM_NAME: Sender name in email headers
# EMAIL_FROM_ADDRESS: Sender email (development placeholder)
EMAIL_FROM_NAME=Promenade Team
EMAIL_FROM_ADDRESS=noreply@promenade.com

# ============================================================================
# Purge Configuration (Soft Delete Cleanup)
# ============================================================================
# PURGE_ENABLED: Enable automatic purge in development
# PURGE_SCHEDULE: Cron schedule (6 fields: second minute hour day month weekday)
#   Note: Currently uses 5-field format, should be 6 for robfig/cron v3
# PURGE_DRY_RUN: Set to true for testing without actual deletion
# PURGE_BATCH_SIZE: Records per batch
# PURGE_RETENTION_USER_POSTS: Retention period for deleted posts (90 days)
# PURGE_RETENTION_POST_COMMENTS: Retention period for deleted comments (30 days)
PURGE_ENABLED=true
PURGE_SCHEDULE=0 2 * * *
PURGE_DRY_RUN=false
PURGE_BATCH_SIZE=1000
PURGE_RETENTION_USER_POSTS=90
PURGE_RETENTION_POST_COMMENTS=30
