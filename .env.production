# ============================================================================
# Application Configuration
# ============================================================================
# APP_NAME: Application display name used in emails and UI
# APP_URL: Base URL for generating links in emails and callbacks
#   IMPORTANT: Update to your production domain (e.g., https://api.promenade.com)
APP_NAME=Promenade
APP_URL=http://localhost:8080

# ============================================================================
# Server Configuration
# ============================================================================
# SERVER_PORT: HTTP server listening port (standard: 8080)
# ENVIRONMENT: Must be "production" for production builds
#   Production mode enables: minimal logging, error masking, security features
SERVER_PORT=8080
ENVIRONMENT=production

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL connection settings for production database
# DB_HOST: Database server hostname (use internal hostname in cluster)
# DB_PORT: PostgreSQL port (default: 5432)
# DB_USER: Database username (use dedicated app user, not superuser!)
# DB_PASSWORD: Strong database password (rotate regularly!)
#   CRITICAL: Change default password immediately!
# DB_NAME: Production database name
# DB_SSLMODE: SSL mode (MUST be 'require' or higher in production!)
#   Options: require, verify-ca, verify-full
# DB_MAX_OPEN_CONNS: Max connections (tune based on instance size)
# DB_MAX_IDLE_CONNS: Idle connections (5-10 recommended)
DB_HOST=localhost
DB_PORT=5432
DB_USER=system
DB_PASSWORD=passw0rd
DB_NAME=promenade_prod
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# ============================================================================
# JWT Configuration
# ============================================================================
# JWT_SECRET: CRITICAL - Secret key for signing JWT tokens
#   Generate with: openssl rand -base64 32
#   NEVER commit production secret to git!
#   Store in secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
# JWT_ACCESS_TTL_MINUTES: Access token lifetime (15 min recommended)
# JWT_REFRESH_TTL_HOURS: Refresh token lifetime (7 days default)
JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168

# ============================================================================
# Swagger Configuration
# ============================================================================
# SWAGGER_ENABLED: MUST be false in production (security risk!)
# SWAGGER_HOST: Not used when disabled
SWAGGER_ENABLED=true
SWAGGER_HOST=localhost:8081

# ============================================================================
# Rate Limiting
# ============================================================================
# RATE_LIMIT_RPS: Requests per second per IP (tune based on traffic)
# RATE_LIMIT_BURST: Burst capacity (allows temporary spikes)
#   Adjust based on monitoring and DDoS protection needs
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# ============================================================================
# Event Bus Configuration
# ============================================================================
# BUS_ADAPTER: Event bus adapter type
#   - "memory" : In-memory adapter (fast, suitable for dev and single-instance)
#   - "redis"  : Redis Pub/Sub adapter (distributed, for multi-instance and microservices)
# Production: Use Redis for distributed event processing
# Graceful degradation: Automatically switches to memory with warning if Redis is unavailable
#
# BUS_WORKER_POOL_SIZE: Concurrent workers (10-20 for production load)
# BUS_BUFFER_SIZE: Event queue size (1000+ for high throughput)
# BUS_RETRY_ATTEMPTS: Max retries (3 recommended for reliability)
# BUS_RETRY_DELAY: Initial retry delay (1s)
# BUS_RETRY_MAX_DELAY: Max retry delay (30s cap for exponential backoff)
# BUS_RETRY_MULTIPLIER: Backoff multiplier (2.0 = doubles each retry)
BUS_ADAPTER=redis
BUS_WORKER_POOL_SIZE=10
BUS_BUFFER_SIZE=1000
BUS_RETRY_ATTEMPTS=3
BUS_RETRY_DELAY=1s
BUS_RETRY_MAX_DELAY=30s
BUS_RETRY_MULTIPLIER=2.0

# ============================================================================
# Redis Configuration (used when BUS_ADAPTER=redis)
# ============================================================================
# REDIS_HOST: Redis server hostname (use internal cluster hostname)
# REDIS_PORT: Redis port (default: 6379)
# REDIS_PASSWORD: Redis AUTH password (REQUIRED in production!)
#   Store in secrets manager, never commit to git
# REDIS_DB: Redis database number (0-15, use 0 for simplicity)
# REDIS_POOL_SIZE: Connection pool size (20+ for production with multiple instances)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20

# ============================================================================
# Email Configuration
# ============================================================================
# EMAIL_FROM_NAME: Sender name displayed in emails
# EMAIL_FROM_ADDRESS: Sender email address (must be verified/whitelisted)
#   Configure SMTP/SendGrid credentials in email service implementation
EMAIL_FROM_NAME=Promenade Team
EMAIL_FROM_ADDRESS=noreply@promenade.com

# ============================================================================
# Purge Configuration (Soft Delete Cleanup)
# ============================================================================
# PURGE_ENABLED: Enable automatic purge of soft-deleted records
#   Recommended: true for production to prevent database bloat
# PURGE_SCHEDULE: Cron schedule (6 fields: second minute hour day month weekday)
#   Default: "0 2 * * *" = 2 AM daily during low traffic
#   Note: Using 5-field format, should be 6 for robfig/cron v3
# PURGE_DRY_RUN: If true, logs deletions without executing (for testing)
# PURGE_BATCH_SIZE: Records per batch (1000-5000 recommended)
#   Larger batches = faster but more load
# PURGE_RETENTION_USER_POSTS: Days to retain deleted posts (90 days default)
# PURGE_RETENTION_POST_COMMENTS: Days to retain deleted comments (30 days default)
#   Adjust retention based on legal/compliance requirements
PURGE_ENABLED=true
PURGE_SCHEDULE=0 2 * * *
PURGE_DRY_RUN=false
PURGE_BATCH_SIZE=1000
PURGE_RETENTION_USER_POSTS=90
PURGE_RETENTION_POST_COMMENTS=30
