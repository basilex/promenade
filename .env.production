# Application
APP_NAME=Promenade
APP_URL=http://localhost:8080

# Server Configuration
SERVER_PORT=8080
ENVIRONMENT=production

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=system
DB_PASSWORD=passw0rd
DB_NAME=promenade_prod
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# JWT Configuration
# openssl rand -base64 32
JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168

# Swagger Configuration
SWAGGER_ENABLED=true
SWAGGER_HOST=localhost:8081

# Rate Limiting
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# Event Bus Configuration
BUS_WORKER_POOL_SIZE=10
BUS_BUFFER_SIZE=1000
BUS_RETRY_ATTEMPTS=3
BUS_RETRY_DELAY=1s
BUS_RETRY_MAX_DELAY=5s
BUS_RETRY_MULTIPLIER=2.0

# Email Configuration
EMAIL_FROM_NAME=Promenade Team
EMAIL_FROM_ADDRESS=noreply@promenade.com
