# ============================================================================
# Promenade - .gitignore
# ============================================================================

# Binaries (ignore binary files in root, not directories)
/api
/main
bin/
seed
*.exe
*.exe~
*.dll
*.so
*.dylib

# Demo binaries (exclude demo source directories)
*_demo
!examples/*_demo/

# Test binaries & outputs
*.test
*.out
test_output.txt
*.test.json

# Go workspace file
go.work
go.work.sum

# Environment variables
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production

# Workspace state (local configuration)
.promenade.workspace
.promenade.workspace.bak

# IDE & Editors
.vscode/
.idea/
*.swp
*.swo
*~
*.iml
.project
.classpath
.settings/

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Coverage & Reports
coverage.out
coverage.html
coverage.txt
*.cover
*.coverprofile

# Temporary files
tmp/
temp/
*.tmp

# Backup & Old files
*.disabled
*.backup
*.bak
*.old
*~
\#*\#
.#*

# Logs
*.log
logs/
*.log.*

# VitePress build output (website)
website/.vitepress/dist/
website/.vitepress/cache/

# Project-specific
*.code-workspace
*.sublime-project
*.sublime-workspace

# Test scripts (use make test instead)
test_*.sh
*_test.sh

# Database dumps
*.sql.gz
*.dump
pg_dump_*

# API documentation (auto-generated)
docs/swagger_v1.json
docs/swagger_v2.json
docs/swagger_v1.yaml
docs/swagger_v2.yaml

# Node modules (if any JS tooling)
node_modules/
package-lock.json

# Vendor (if used)
vendor/

# Air live reload (if used)
.air.toml
tmp/

